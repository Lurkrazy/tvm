+                                v1 = T.axis.spatial(256, k_0 * 32 + ax0_ax1_fused % 32)
+                                T.reads(A[v0, v1])
+                                T.writes(A_local[v0, v1])
+                                T.block_attr({"meta_schedule.cooperative_fetch": 4})
+                                A_local[v0, v1] = A[v0, v1]
+                        for ax0_ax1_fused in range(256):
