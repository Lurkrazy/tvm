+                                v1 = T.axis.spatial(256, i_1_j_1_fused * 128 + i_2_j_2_fused % 16 * 8 + ax0_ax1_fused % 8)
+                                T.reads(B[v0, v1])
+                                T.writes(B_local[v0, v1])
+                                T.block_attr({"meta_schedule.cooperative_fetch": 4})
+                                B_local[v0, v1] = B[v0, v1]
