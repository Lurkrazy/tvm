+    plt.plot(tuning_times, gd_time, label="Meta Schedule Time")
+
+    # 添加标题和标签
+    plt.title("Comparison of GD Time and EV Time")
+    plt.xlabel("Tuning Time (s)")
+    plt.ylabel("Latency (ms)")
